(define (problem frogs-4v4)
  (:domain frogs-jumping)
  (:objects
    l1 l2 l3 l4 - leftfrog
    r1 r2 r3 r4 - rightfrog
    p1 p2 p3 p4 p5 p6 p7 p8 p9 - lilypad)
  (:init
    (next p1 p2)
    (next p2 p3)
    (next p3 p4)
    (next p4 p5)
    (next p5 p6)
    (next p6 p7)
    (next p7 p8)
    (next p8 p9)
    (at l1 p1)
    (at l2 p2)
    (at l3 p3)
    (at l4 p4)
    (empty p5)
    (at r1 p6)
    (at r2 p7)
    (at r3 p8)
    (at r4 p9)
  )
  (:goal (and
    (at r1 p1)
    (at r2 p2)
    (at r3 p3)
    (at r4 p4)
    (empty p5)
    (at l1 p6)
    (at l2 p7)
    (at l3 p8)
    (at l4 p9)
  ))
)

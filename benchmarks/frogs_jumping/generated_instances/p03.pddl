(define (problem frogs-5v5)
  (:domain frogs-jumping)
  (:objects
    l1 l2 l3 l4 l5 - leftfrog
    r1 r2 r3 r4 r5 - rightfrog
    p1 p2 p3 p4 p5 p6 p7 p8 p9 p10 p11 - lilypad)
  (:init
    (next p1 p2)
    (next p2 p3)
    (next p3 p4)
    (next p4 p5)
    (next p5 p6)
    (next p6 p7)
    (next p7 p8)
    (next p8 p9)
    (next p9 p10)
    (next p10 p11)
    (at l1 p1)
    (at l2 p2)
    (at l3 p3)
    (at l4 p4)
    (at l5 p5)
    (empty p6)
    (at r1 p7)
    (at r2 p8)
    (at r3 p9)
    (at r4 p10)
    (at r5 p11)
  )
  (:goal (and
    (at r1 p1)
    (at r2 p2)
    (at r3 p3)
    (at r4 p4)
    (at r5 p5)
    (empty p6)
    (at l1 p7)
    (at l2 p8)
    (at l3 p9)
    (at l4 p10)
    (at l5 p11)
  ))
)
